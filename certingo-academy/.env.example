# ============================================================================
# Certingo Academy - Environment configuration
# Copy this file to backend/.env (or export the variables) and adjust values.
# All variables are read by backend/app/config.py (pydantic-settings).
# ============================================================================

# --- Environment ------------------------------------------------------------
# "dev" or "production". In production the app REFUSES to start without
# JWT_SECRET and FIELD_ENCRYPTION_KEY.
ENV=dev

# --- Database ---------------------------------------------------------------
# SQLAlchemy database URL. Defaults to a local SQLite file.
# Examples:
#   sqlite:///./certingo.db
#   postgresql+psycopg2://user:password@localhost:5432/certingo
DATABASE_URL=sqlite:///./certingo.db

# --- CORS -------------------------------------------------------------------
# Allowed frontend origins. Comma-separated list or JSON array.
# Never use "*" together with credentials.
CORS_ORIGINS=http://localhost:3000

# --- Auth / JWT -------------------------------------------------------------
# Secret used to sign access tokens (HS256). REQUIRED in production.
# In dev, an insecure default is used if unset (never deploy with it).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# JWT signing algorithm.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default 1440 = 24h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Secrets vault (field-level encryption) ---------------------------------
# Fernet key used to encrypt tenant secrets at rest. REQUIRED in production.
# In dev, if unset, a key is generated once and persisted to backend/.field_key
# (gitignored) so encrypted secrets survive restarts.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- AI ---------------------------------------------------------------------
# Global AI provider override: "mock" (default), "openai", "anthropic", "mcp".
#   mock      -> deterministic canned responses, no external calls (default)
#   openai    -> OpenAI Chat Completions via httpx (JSON mode)
#   anthropic -> Anthropic Messages API via the official SDK (structured outputs)
#   mcp       -> not implemented yet; tenants selecting it fall back to mock
# When set to something other than "mock" it overrides every tenant's
# TenantAISettings.provider.
AI_PROVIDER=mock

# Optional DEV FALLBACK API keys. In production, provider keys are stored
# per-tenant in the encrypted secrets vault (POST /api/admin/secrets with key
# OPENAI_API_KEY / ANTHROPIC_API_KEY). These env vars are only consulted when
# the tenant's vault has no key — convenient for local development.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Multi-tenancy ----------------------------------------------------------
# Tenant slug used by /api/auth/register and /api/auth/login when the request
# does not specify tenant_slug. The seed (backend/app/database/seed.py) creates
# the demo tenant with slug "demo".
DEFAULT_TENANT_SLUG=demo

# ============================================================================
# Demo credentials (created by `python -m app.database.seed` from backend/)
#   superadmin@certingo.demo / superadmin123  (SUPER_ADMIN)
#   admin@certingo.demo      / admin123       (TENANT_ADMIN)
#   student@certingo.demo    / student123     (STUDENT)
# All belong to the demo tenant (slug "demo").
# ============================================================================
